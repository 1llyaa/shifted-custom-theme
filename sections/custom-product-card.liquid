{% comment %}
  Custom Product Card Section
  A fully customizable product card with block-based components.
  Each element (image, title, price, button, etc.) is a separate block
  that can be reordered, styled, and configured independently.
{% endcomment %}

{% liquid
  assign product = section.settings.product
  if product == blank and request.visual_preview_mode
    assign product = collections.all.products.first
  endif
  
  assign card_id = 'custom-card-' | append: section.id
%}

{% style %}
  #{{ card_id }} {
    --card-padding: {{ section.settings.card_padding }}px;
    --card-gap: {{ section.settings.content_gap }}px;
    --card-bg: {{ section.settings.card_background }};
    --card-border-radius: {{ section.settings.card_border_radius }}px;
    --card-border-width: {{ section.settings.card_border_width }}px;
    --card-border-color: {{ section.settings.card_border_color }};
    --card-shadow: {{ section.settings.card_shadow_x }}px {{ section.settings.card_shadow_y }}px {{ section.settings.card_shadow_blur }}px {{ section.settings.card_shadow_color }};
    
    /* Hover states */
    --card-hover-lift: {{ section.settings.hover_lift }}px;
    --card-hover-scale: {{ section.settings.hover_scale | divided_by: 100.0 }};
    --card-transition: {{ section.settings.transition_duration }}ms {{ section.settings.transition_easing }};
  }

  .custom-product-card__wrapper-{{ section.id }} {
    display: block;
    width: 100%;
    {% if section.settings.max_width > 0 %}
      max-width: {{ section.settings.max_width }}px;
    {% endif %}
  }

  .custom-product-card-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: var(--card-gap);
    padding: var(--card-padding);
    background: var(--card-bg);
    border-radius: var(--card-border-radius);
    border: var(--card-border-width) solid var(--card-border-color);
    box-shadow: var(--card-shadow);
    position: relative;
    overflow: hidden;
    transition: 
      transform var(--card-transition),
      box-shadow var(--card-transition),
      border-color var(--card-transition);
  }

  .custom-product-card-{{ section.id }} a {
    text-decoration: none;
    color: inherit;
  }

  /* Card link overlay for clickable card */
  {% if section.settings.card_clickable %}
    .custom-product-card__link-{{ section.id }} {
      position: absolute;
      inset: 0;
      z-index: 1;
    }
    
    .custom-product-card-{{ section.id }} button,
    .custom-product-card-{{ section.id }} .custom-card-button {
      position: relative;
      z-index: 2;
    }
  {% endif %}

  /* Hover effects */
  @media (any-pointer: fine) and (prefers-reduced-motion: no-preference) {
    {% case section.settings.hover_effect %}
      {% when 'lift' %}
        .custom-product-card-{{ section.id }}:hover {
          transform: translateY(calc(-1 * var(--card-hover-lift)));
          box-shadow: 
            var(--card-shadow),
            0 calc(var(--card-hover-lift) * 2) calc(var(--card-hover-lift) * 4) rgba(0, 0, 0, 0.1);
        }
      {% when 'scale' %}
        .custom-product-card-{{ section.id }}:hover {
          transform: scale(var(--card-hover-scale));
        }
      {% when 'border' %}
        .custom-product-card-{{ section.id }}:hover {
          border-color: {{ section.settings.hover_border_color }};
        }
      {% when 'glow' %}
        .custom-product-card-{{ section.id }}:hover {
          box-shadow: 
            var(--card-shadow),
            0 0 {{ section.settings.hover_glow_size }}px {{ section.settings.hover_glow_spread }}px {{ section.settings.hover_glow_color }};
        }
    {% endcase %}
  }
{% endstyle %}

<div id="{{ card_id }}" class="custom-product-card__wrapper-{{ section.id }}">
  <article class="custom-product-card-{{ section.id }}" data-product-id="{{ product.id }}">
    
    {% if section.settings.card_clickable and product != blank %}
      <a href="{{ product.url }}" class="custom-product-card__link-{{ section.id }}" aria-label="{{ product.title }}">
        <span class="visually-hidden">{{ product.title }}</span>
      </a>
    {% endif %}

    {% for block in section.blocks %}
      {% case block.type %}
        
        {% when 'image' %}
          {% render 'custom-card-image', 
            product: product, 
            block: block, 
            section_id: section.id 
          %}

        {% when 'title' %}
          {% render 'custom-card-title', 
            product: product, 
            block: block, 
            section_id: section.id 
          %}

        {% when 'price' %}
          {% render 'custom-card-price', 
            product: product, 
            block: block, 
            section_id: section.id 
          %}

        {% when 'button' %}
          {% render 'custom-card-button', 
            product: product, 
            block: block, 
            section_id: section.id 
          %}

        {% when 'vendor' %}
          {% render 'custom-card-vendor', 
            product: product, 
            block: block, 
            section_id: section.id 
          %}

        {% when 'badge' %}
          {% render 'custom-card-badge', 
            product: product, 
            block: block, 
            section_id: section.id 
          %}

        {% when 'rating' %}
          {% render 'custom-card-rating', 
            product: product, 
            block: block, 
            section_id: section.id 
          %}

        {% when 'swatches' %}
          {% render 'custom-card-swatches', 
            product: product, 
            block: block, 
            section_id: section.id 
          %}

        {% when 'divider' %}
          <div 
            class="custom-card-divider-{{ section.id }}"
            style="
              height: {{ block.settings.thickness }}px;
              background: {{ block.settings.color }};
              margin: {{ block.settings.spacing }}px 0;
              border-radius: {{ block.settings.thickness | divided_by: 2 }}px;
            "
            {{ block.shopify_attributes }}
          ></div>

        {% when 'spacer' %}
          <div 
            class="custom-card-spacer-{{ section.id }}"
            style="height: {{ block.settings.height }}px;"
            {{ block.shopify_attributes }}
          ></div>

        {% when 'custom_text' %}
          <div 
            class="custom-card-text-{{ section.id }}"
            style="
              font-size: {{ block.settings.font_size }}px;
              font-weight: {{ block.settings.font_weight }};
              color: {{ block.settings.text_color }};
              text-align: {{ block.settings.alignment }};
              {% if block.settings.text_transform != 'none' %}
                text-transform: {{ block.settings.text_transform }};
              {% endif %}
            "
            {{ block.shopify_attributes }}
          >
            {{ block.settings.text }}
          </div>

      {% endcase %}
    {% endfor %}

  </article>
</div>

