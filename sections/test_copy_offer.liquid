<div
  class="test-copy-offer color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="test-copy-offer__container page-width">
    {% if section.settings.headline != blank %}
      <h2 class="test-copy-offer__headline">
        {{ section.settings.headline }}
      </h2>
    {% endif %}

    <div class="test-copy-offer__columns">
      {% assign included_items = section.blocks | where: 'type', 'included_item' %}
      {% if included_items.size > 0 %}
        <div class="test-copy-offer__column">
          {% if section.settings.included_title != blank %}
            <h3 class="test-copy-offer__column-title">{{ section.settings.included_title }}</h3>
          {% endif %}
          <ul class="test-copy-offer__list">
            {% for block in included_items %}
              <li class="test-copy-offer__list-item test-copy-offer__list-item--included" {{ block.shopify_attributes }}>
                <span class="test-copy-offer__check">✔</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% assign optional_items = section.blocks | where: 'type', 'optional_item' %}
      {% if optional_items.size > 0 %}
        <div class="test-copy-offer__column">
          {% if section.settings.optional_title != blank %}
            <h3 class="test-copy-offer__column-title">{{ section.settings.optional_title }}</h3>
          {% endif %}
          <ul class="test-copy-offer__list">
            {% for block in optional_items %}
              <li class="test-copy-offer__list-item test-copy-offer__list-item--optional" {{ block.shopify_attributes }}>
                <span class="test-copy-offer__bullet">•</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>

    {% if section.settings.guarantee != blank %}
      <div class="test-copy-offer__guarantee">
        <span class="test-copy-offer__guarantee-icon">🛡️</span>
        <span class="test-copy-offer__guarantee-text">{{ section.settings.guarantee }}</span>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .test-copy-offer {
    padding-top: var(--section-padding-top, 60px);
    padding-bottom: var(--section-padding-bottom, 60px);
    overflow: hidden;
  }

  .test-copy-offer__container {
    max-width: 900px;
    margin: 0 auto;
    padding-inline: var(--page-margin, 1.5rem);
    box-sizing: border-box;
    width: 100%;
  }

  .test-copy-offer__headline {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 2.5rem;
    text-align: center;
  }

  .test-copy-offer__columns {
    display: grid;
    gap: 2.5rem;
  }

  @media screen and (min-width: 750px) {
    .test-copy-offer__columns {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .test-copy-offer__column {
    padding: 2rem;
    background: rgb(var(--color-foreground-rgb) / 0.03);
    border-radius: 12px;
  }

  .test-copy-offer__column-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 1.5rem;
  }

  .test-copy-offer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .test-copy-offer__list-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  .test-copy-offer__check {
    color: rgb(76, 175, 80);
    font-weight: bold;
    flex-shrink: 0;
  }

  .test-copy-offer__bullet {
    color: rgb(var(--color-foreground-rgb) / 0.5);
    flex-shrink: 0;
  }

  .test-copy-offer__guarantee {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: rgb(var(--color-accent-rgb, 76, 175, 80) / 0.1);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
  }

  .test-copy-offer__guarantee-icon {
    font-size: 1.5rem;
  }

  .test-copy-offer__guarantee-text {
    font-size: 1.1rem;
    font-weight: 500;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:test_copy.offer.name",
  "tag": "section",
  "class": "test-copy-offer-wrapper section-wrapper",
  "blocks": [
    {
      "type": "included_item",
      "name": "t:test_copy.offer.blocks.included_item.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:test_copy.offer.blocks.included_item.settings.text",
          "default": "Prémiový automobilový plakát"
        }
      ]
    },
    {
      "type": "optional_item",
      "name": "t:test_copy.offer.blocks.optional_item.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:test_copy.offer.blocks.optional_item.settings.text",
          "default": "Různé velikosti"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "t:test_copy.offer.settings.headline",
      "default": "Co dostaneš"
    },
    {
      "type": "text",
      "id": "included_title",
      "label": "t:test_copy.offer.settings.included_title",
      "default": "Zahrnuto v ceně:"
    },
    {
      "type": "text",
      "id": "optional_title",
      "label": "t:test_copy.offer.settings.optional_title",
      "default": "Volitelné možnosti:"
    },
    {
      "type": "text",
      "id": "guarantee",
      "label": "t:test_copy.offer.settings.guarantee",
      "default": "Nelíbí se? Vrátíme peníze. Bez řečí."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "t:test_copy.offer.presets.name",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "included_item",
          "settings": {
            "text": "Prémiový automobilový plakát"
          }
        },
        {
          "type": "included_item",
          "settings": {
            "text": "Kvalitní rám"
          }
        },
        {
          "type": "included_item",
          "settings": {
            "text": "Bezpečné ochranné balení"
          }
        },
        {
          "type": "optional_item",
          "settings": {
            "text": "Různé velikosti"
          }
        },
        {
          "type": "optional_item",
          "settings": {
            "text": "Limitované edice vybraných vozů"
          }
        }
      ]
    }
  ]
}
{% endschema %}
