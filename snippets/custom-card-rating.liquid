{% doc %}
  Renders star rating for custom product card.
  
  @param {product} product - The product object
  @param {block} block - The block object with settings
  @param {string} section_id - The section ID
{% enddoc %}

{% liquid
  assign star_color = block.settings.star_color
  assign empty_star_color = block.settings.empty_star_color
  assign star_size = block.settings.star_size
  assign show_count = block.settings.show_count
  assign alignment = block.settings.alignment

  # Get rating from metafield if available
  assign rating_value = 0
  assign rating_count = 0
  
  if product != blank and product.metafields.reviews.rating.value
    assign rating_value = product.metafields.reviews.rating.value.rating | round: 1
    assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  endif
%}

{% style %}
  .custom-card-rating-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    {% if alignment == 'center' %}
      justify-content: center;
    {% elsif alignment == 'right' %}
      justify-content: flex-end;
    {% endif %}
  }

  .custom-card-rating-{{ section_id }} .stars {
    display: flex;
    gap: 2px;
  }

  .custom-card-rating-{{ section_id }} .star {
    width: {{ star_size }}px;
    height: {{ star_size }}px;
  }

  .custom-card-rating-{{ section_id }} .star svg {
    width: 100%;
    height: 100%;
  }

  .custom-card-rating-{{ section_id }} .star--filled svg {
    fill: {{ star_color }};
    stroke: {{ star_color }};
  }

  .custom-card-rating-{{ section_id }} .star--empty svg {
    fill: {{ empty_star_color }};
    stroke: {{ empty_star_color }};
  }

  .custom-card-rating-{{ section_id }} .star--half {
    position: relative;
  }

  .custom-card-rating-{{ section_id }} .star--half svg:first-child {
    fill: {{ star_color }};
    stroke: {{ star_color }};
    clip-path: inset(0 50% 0 0);
  }

  .custom-card-rating-{{ section_id }} .star--half svg:last-child {
    position: absolute;
    top: 0;
    left: 0;
    fill: {{ empty_star_color }};
    stroke: {{ empty_star_color }};
    clip-path: inset(0 0 0 50%);
  }

  .custom-card-rating-{{ section_id }} .rating-count {
    font-size: 12px;
    color: #666;
  }
{% endstyle %}

{% if rating_value > 0 %}
  <div class="custom-card-rating-{{ section_id }}" {{ block.shopify_attributes }}>
    <div class="stars">
      {% for i in (1..5) %}
        {% if rating_value >= i %}
          <span class="star star--filled">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </span>
        {% elsif rating_value > i | minus: 1 %}
          <span class="star star--half">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </span>
        {% else %}
          <span class="star star--empty">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </span>
        {% endif %}
      {% endfor %}
    </div>
    {% if show_count and rating_count > 0 %}
      <span class="rating-count">({{ rating_count }})</span>
    {% endif %}
  </div>
{% endif %}
